# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# Either provide a full connection string...
DATABASE_URL=postgres://fpgod:fpgod@localhost:5432/fpgod
# ...or the individual parts (DATABASE_URL takes precedence if set)
PGHOST=localhost
PGPORT=5432
PGUSER=fpgod
PGPASSWORD=fpgod
PGDATABASE=fpgod
# Set to true when connecting to a managed cloud Postgres that requires SSL
PGSSL=false

# ---- Firm ----
# The advising firm. Generators are told this explicitly so they never
# reproduce the previous practice's letterhead, AR number or AFSL from
# imported reference material.
FIRM_NAME=Legacy Risk Advice

# ---- Anthropic (Claude) ----
# Without a key the AI endpoints run in stub mode (clearly-labelled placeholder output).
ANTHROPIC_API_KEY=
# claude-opus-5 — 1M context, $5/$25 per MTok. Thinking is adaptive and on by default.
ANTHROPIC_MODEL=claude-opus-5

# ---- Storage ----
# 'local' writes to ./uploads. Add 's3'/'gcs' drivers later without changing routes.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# Max upload size in megabytes
MAX_UPLOAD_MB=25

# Microsoft Graph — mailbox scanning for automation/tasks (the live task list).
# Delegated Mail.Read against your own mailbox. Run `npm run setup` in
# automation/tasks for the app-registration steps.
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
