{
  "name": "fpgod",
  "version": "1.0.0",
  "private": true,
  "description": "FPGod — AI-powered financial planning application (monorepo root)",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "start:server": "npm --prefix server start"
  },
  "engines": {
    "node": ">=20"
  }
}
