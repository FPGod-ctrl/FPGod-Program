# Dependencies
node_modules/
.pnp
.pnp.js

# Environment
.env
.env.local
.env.*.local

# Build output
dist/
build/
client/dist/

# Uploaded files (keep the folder, not its contents)
server/uploads/*
!server/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Coverage / cache
coverage/
.cache/
.vite/

# Test artefacts (vitest UPLOAD_DIR)
server/uploads-test/
server/data-test/

# Client documents dropped for analysis — real PII, large binaries.
# Read in place; never committed. READMEs stay tracked.
legacy/drop/**/*.docx
legacy/drop/**/*.pdf
legacy/drop/**/*.doc
legacy/drop/**/.extracted/

# Transcripts and meeting notes arrive as plain text, so text formats in the
# drop folder are PII too. Ignore them, keeping the task READMEs tracked.
legacy/drop/**/*.txt
legacy/drop/**/*.md
!legacy/drop/README.md
!legacy/drop/**/README.md

# Whole client folders for SOA builds arrive in any format (xlsx, msg, images),
# so ignore everything in them rather than listing extensions.
legacy/drop/soa-build/cases/*
!legacy/drop/soa-build/cases/README.md

# Produced client documents — file notes, fact finds, SOAs, profiles, reports.
# These are finished work about real people. Keep the folders, not the contents.
legacy/follow-ups/*
legacy/file-notes/*
legacy/fact-finds/*
legacy/client-profiles/*
legacy/risk-reports/*
legacy/soa/*
legacy/templates/*
!legacy/**/.gitkeep
!legacy/**/README.md

# Task tracker state: carries client names and (historically) email subjects.
server/data/task-state/

# Adviser documents (FSGs, AR certificates, profiles) stay local, out of git
legacy/advisers/**/*
!legacy/advisers/**/
!legacy/advisers/README.md

# Logo harvest workings: page images taken from client folders.
legacy/drop/**/.logo-harvest/
