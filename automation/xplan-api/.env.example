# Copy to .env (gitignored) and fill in the values Iress gives your administrator.
# Nothing here is committed.

# Your XPLAN site / API base (Iress will confirm the exact API base host)
XPLAN_BASE_URL=https://yourfirm.xplan.iress.com.au

# OAuth 2.0 app-key credentials (from the Iress Custom Integration key)
XPLAN_CLIENT_ID=
XPLAN_CLIENT_SECRET=

# OAuth 2.0 endpoints (Iress provides these for your site)
XPLAN_AUTH_URL=
XPLAN_TOKEN_URL=

# Space-separated scopes/capabilities granted to the key
# (e.g. risk_researcher client_read ips_read — confirm exact names with Iress)
XPLAN_SCOPES=

# Local redirect listener — register this exact URI with Iress
XPLAN_REDIRECT_URI=http://localhost:8765/callback
